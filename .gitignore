# models/ : base model weights, user-trained/downloaded LoRAs, dirs.json
# Both are re-created by the engine at runtime; base weights are
# re-downloadable (see README) and user content stays on disk only.
data/
models/

# ── logs ────────────────────────────────────────────────────────
*.log
