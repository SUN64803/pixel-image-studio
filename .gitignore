# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
engine/.venv/

# ── Node / Electron ─────────────────────────────────────────────
electron/node_modules/
electron/dist/
electron/out/

# ── runtime content (user-made, kept out of the repo) ──────────
